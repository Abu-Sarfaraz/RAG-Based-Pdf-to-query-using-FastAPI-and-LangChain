name: Regression checks

on:
  push:
  pull_request:

permissions:
  contents: read

concurrency:
  group: checks-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  regression:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    env:
      HF_HUB_OFFLINE: "1"
      TOKENIZERS_PARALLELISM: "false"
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip
          cache-dependency-path: |
            backend/requirements*.txt
            frontend/requirements*.txt
      - name: Install isolated dependencies
        run: |
          python -m venv backend/.venv
          python -m venv frontend/.venv
          backend/.venv/bin/python -m pip install torch==2.14.1 --index-url https://download.pytorch.org/whl/cpu
          backend/.venv/bin/python -m pip install -r backend/requirements-dev.txt
          frontend/.venv/bin/python -m pip install -r frontend/requirements-dev.txt
          frontend/.venv/bin/python -m playwright install --with-deps chromium
      - name: Check dependencies and regressions
        run: |
          backend/.venv/bin/python -m pip check
          frontend/.venv/bin/python -m pip check
          cd backend
          .venv/bin/python -m unittest discover -s tests -t . -v
          cd ..
          python -m unittest discover -s frontend/tests -v
          git diff --check
      - name: Check browser workflow
        shell: bash
        run: |
          (cd backend && exec .venv/bin/python -m uvicorn tests.browser_server:app --host 127.0.0.1 --port 18000) > /tmp/backend.log 2>&1 &
          backend_pid=$!
          (cd frontend && BACKEND_URL=http://127.0.0.1:18000 exec .venv/bin/python -m streamlit run app.py --server.address 127.0.0.1 --server.port 18501 --server.headless true) > /tmp/frontend.log 2>&1 &
          frontend_pid=$!
          trap 'kill "$backend_pid" "$frontend_pid" 2>/dev/null || true' EXIT
          python - <<'PY'
          import time
          import urllib.error
          import urllib.request
          for url in ("http://127.0.0.1:18000/health", "http://127.0.0.1:18501/_stcore/health"):
              for attempt in range(60):
                  try:
                      with urllib.request.urlopen(url, timeout=2) as response:
                          if response.status == 200:
                              break
                  except (urllib.error.URLError, TimeoutError):
                      pass
                  time.sleep(1)
              else:
                  raise SystemExit(f"Service did not start: {url}")
          PY
          frontend/.venv/bin/python scripts/browser_check.py --artifacts test-results/browser
      - name: Upload browser artifacts and logs
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: browser-checks
          path: |
            test-results/browser
            /tmp/backend.log
            /tmp/frontend.log
          if-no-files-found: ignore
