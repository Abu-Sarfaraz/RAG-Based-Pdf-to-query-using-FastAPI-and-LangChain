# --- Chat LLM (Groq) ---
# Get a key at https://console.groq.com/keys
CHAT_API_KEY=
LLM_MODEL=openai/gpt-oss-20b

# Embeddings are generated locally by sentence-transformers (see app/embeddings.py).
# The model (~80 MB) is bundled into the Docker image.

# Vectors are stored in a local FAISS index (see app/db.py).
# On Render free tier the container is ephemeral, so the index is rebuilt
# on cold start — users re-ingest their PDFs each session.
# To make the index survive restarts, point this at a mounted disk path.
# FAISS_INDEX_DIR=./.faiss_index