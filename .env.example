# --- Neon Postgres (PGVector) ---
# Run once in Neon SQL console: CREATE EXTENSION IF NOT EXISTS vector;
NEON_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- Chat LLM (Groq) ---
# Get a key at https://console.groq.com/keys
CHAT_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Embeddings are generated locally by sentence-transformers (see app/embeddings.py).
# No API key needed. The model (~80 MB) is bundled into the Docker image.