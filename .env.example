# Groq account: https://console.groq.com/keys
CHAT_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Optional: place all private documents, catalog and indexes on persistent storage.
# DATA_DIR=/absolute/path/to/papertrail-data
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=300
EMBEDDING_THREADS=2

# Only needed when a browser client calls the API directly.
ALLOWED_ORIGINS=http://localhost:8501
