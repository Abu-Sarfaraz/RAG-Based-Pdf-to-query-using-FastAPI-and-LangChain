# Groq account: https://console.groq.com/keys
CHAT_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY is accepted as a fallback when CHAT_API_KEY is empty.
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional: place all private documents, catalog and indexes on persistent storage.
# DATA_DIR=/absolute/path/to/papertrail-data
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=300
EMBEDDING_THREADS=2

# Only needed when a browser client calls the API directly.
ALLOWED_ORIGINS=http://localhost:8501

# Set in the frontend process environment when starting Streamlit directly:
# BACKEND_URL=http://localhost:8000
# Streamlit also has a 25 MB limit in frontend/.streamlit/config.toml.
